{
  "name": "@ryuzei/botnest",
  "version": "1.0.0",
  "description": "High-performance universal multi-platform bot framework for WhatsApp (Baileys), Discord.js & Telegram (Telegraf) with unified lifecycle, pairing code support & zero-boilerplate routing.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "homepage": "https://github.com/Ryuzei-Ts/botnest#readme",
  "bugs": {
    "url": "https://github.com/Ryuzei-Ts/botnest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryuzei-Ts/botnest.git"
  },
  "author": "Ryuzei-Ts",
  "license": "MIT",
  "keywords": [
    "bot",
    "botnest",
    "whatsapp",
    "baileys",
    "discord",
    "discordjs",
    "telegram",
    "telegraf",
    "multi-platform"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./native": "./native.node",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#core": "./src/core/index.ts",
    "#core/*": "./src/core/*.ts",
    "#adapters": "./src/adapters/index.ts",
    "#adapters/*": "./src/adapters/*.ts",
    "#engine": "./src/engine/index.ts",
    "#engine/*": "./src/engine/*.ts",
    "#loader": "./src/loader/index.ts",
    "#loader/*": "./src/loader/*.ts",
    "#queue": "./src/queue/index.ts",
    "#queue/*": "./src/queue/*.ts",
    "#storage": "./src/storage/index.ts",
    "#storage/*": "./src/storage/*.ts",
    "#telemetry": "./src/telemetry/index.ts",
    "#telemetry/*": "./src/telemetry/*.ts",
    "#security": "./src/security/index.ts",
    "#security/*": "./src/security/*.ts",
    "#native": "./native.node"
  },
  "scripts": {
    "build:native": "cd native && cargo build --release && cp target/release/libnative.so ../native.node 2>/dev/null || cp target/release/libnative.dylib ../native.node 2>/dev/null || true",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "npm:@systemzero/baileys",
    "chalk": "^5.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.3"
  }
}
